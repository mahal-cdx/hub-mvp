# Threeebs Hub — ambiente inicial
# Copie para .env e substitua os valores de exemplo.
# Nunca versione o .env.

PROJECT_SLUG=hub
APP_NAME=Threeebs Hub
TZ=America/Sao_Paulo
APP_ENV=development
APP_DEBUG=true

BIND_ADDRESS=0.0.0.0

# PHP Admin
ADMIN_PORT=6041

# PHP usuários operacionais:
# Captador, Desenvolvedor e Comercial
USERS_PORT=6042

MYSQL_PORT=6043
REDIS_PORT=6044

MYSQL_ROOT_PASSWORD=TROQUE_A_ROOT_SENHA
MYSQL_DATABASE=sales
MYSQL_USER=sales_app
MYSQL_PASSWORD=TROQUE_A_SENHA_DA_APLICACAO

REDIS_PASSWORD=TROQUE_A_SENHA_REDIS

# Identidade/integração futura
THREEEBS_API_BASE_URL=
THREEEBS_API_TOKEN=
