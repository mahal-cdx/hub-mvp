# Threeebs Hub MVP
# Copie para .env e troque todos os valores marcados como TROQUE.

PROJECT_SLUG=hub
APP_NAME=Threeebs Hub
APP_ENV=development
APP_DEBUG=false
TZ=America/Sao_Paulo

# Chave aleatória com pelo menos 32 caracteres. Use: openssl rand -hex 32
APP_KEY=TROQUE_POR_UMA_CHAVE_ALEATORIA_COM_64_CARACTERES

# HTTP
BIND_ADDRESS=0.0.0.0
ADMIN_PORT=6041
USERS_PORT=6042
APP_URL=http://localhost:6041
SESSION_SECURE=false
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
TRUST_PROXY_HEADERS=false

# Serviços internos. Mantenha 127.0.0.1 quando não precisar de acesso remoto.
DB_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=6043
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6044

MYSQL_ROOT_PASSWORD=TROQUE_A_ROOT_SENHA
MYSQL_DATABASE=hub
MYSQL_USER=hub_app
MYSQL_PASSWORD=TROQUE_A_SENHA_DA_APLICACAO
REDIS_PASSWORD=TROQUE_A_SENHA_REDIS

# Os seeds criam contas e dados de demonstração. Use somente em ambiente local descartável.
LOAD_DEMO_SEEDS=false

# Integração futura. O MVP não depende destas variáveis.
THREEEBS_API_BASE_URL=
THREEEBS_API_TOKEN=
